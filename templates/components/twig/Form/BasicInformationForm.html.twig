{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.basic.title"|trans }}
{% endblock %}

{% block form_content %}
    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').TITLE }}">
        {{ form_row(form.title) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').TITLE_TRANSLATED }}">
        {{ form_row(form.titleTranslated) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').STUDY_ID }}">
        {{ form_row(form.studyId) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').DESCRIPTION }}">
        {{ form_row(form.description) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').DESCRIPTION_TRANSLATED }}">
        {{ form_row(form.descriptionTranslated) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').DATA_STATUS }}">
        {{ form_row(form.dataStatus) }}
        {{ form_row(form.reusePotentialOfDataSubset, {
            'attr': {
                'disabled': form.dataStatus.vars.value != enum('App\\Enum\\Study\\DataStatus').SUBSET.value
            }
        }) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').STUDY_RELATION }}">
        {{ form_row(form.studyRelation) }}
        {{ form_row(form.studyRelationOtherDescription, {
            'attr': {
                'disabled': form.studyRelation.vars.value != enum('App\\Enum\\Study\\StudyRelation').OTHER.value
            }
        }) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').USED_SOFTWARES }}">
        <twig:Form:CollectionForm
            collection="{{ form.usedSoftwares }}"
            add_action="addUsedSoftware"
            remove_action="removeUsedSoftware"
            add_label="{{ 'basic_information_meta_data_group.used_softwares.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').RELATED_PUBLICATIONS }}">
        <twig:Form:CollectionForm
            collection="{{ form.relatedPublications }}"
            add_action="addRelatedPublication"
            remove_action="removeRelatedPublication"
            add_label="{{ 'basic_information_meta_data_group.related_publications.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').CONFLICTS_OF_INTEREST }}">
        <twig:Form:CollectionForm
            collection="{{ form.conflictsOfInterest }}"
            add_action="addConflictOfInterest"
            remove_action="removeConflictOfInterest"
            add_label="{{ 'basic_information_meta_data_group.conflicts_of_interest.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').CREATORS }}">
        {{ form_label(form.creators) }}
        {{ form_errors(form.creators) }}
        <div class="mt-1">
            <ul>
                {% for key, creator in form.creators %}
                    <li class='items-baseline pb-4 mt-2 border rounded border-stone-400 first:mt-0'>
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="removeCreator"
                                data-live-index-param="{{ key }}"
                                class="Creator-RemoveButton">
                            {{ 'basic_information_meta_data_group.creators.remove'|trans([], 'forms') }}
                        </button>

                        <div class="px-4 md:grid md:w-full md:grid-cols-2 md:gap-x-2">
                            {{ form_row(creator.givenName) }}
                            {{ form_row(creator.familyName) }}
                            {{ form_row(creator.email) }}
                            {{ form_row(creator.orcid) }}
                            <span class="col-span-2">
                                {{ form_row(creator.affiliation) }}
                                {{ form_row(creator.responsibilities) }}
                                {% if enum('App\\Enum\\Study\\CreatorResponsibility').OTHER.value in creator.responsibilities.vars.value %}
                                    {{ form_row(creator.responsibilitiesOtherDescription) }}
                                {% else %}
                                    {% do creator.responsibilitiesOtherDescription.setRendered %}
                                {% endif %}
                            </span>

                        </div>
                    </li>
                {% endfor %}
            </ul>

            <button type="button"
                    class="mt-2 Button_secondary_act Button_fieldSize"
                    data-action="live#action"
                    data-live-action-param="addCreator">
                {{ include('components/icons/add.svg') }}
                {{ 'basic_information_meta_data_group.creators.add'|trans([], 'forms') }}
            </button>
        </div>
        {% do form.creators.setRendered %}
    </twig:Form:FormCard>

    {{ form_rest(form) }}
{% endblock %}


