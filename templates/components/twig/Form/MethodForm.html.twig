{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.method.title"|trans }}
{% endblock %}

{% set research_method = form.researchMethod.vars.value %}

{% block form_content %}
    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RESEARCH_DESIGN }}">
        <twig:Form:MultilineChoiceForm form="{{ form.researchDesign }}"/>

        {% if form.researchDesign.vars.value == enum('App\\Enum\\Study\\ResearchDesign').LONGITUDINAL.value %}
            {{ form_row(form.researchDesignDescription) }}
        {% else %}
            {% do form.researchDesignDescription.setRendered %}
        {% endif %}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RESEARCH_METHOD }}">
        {{ form_label(form.researchMethod) }}
        {{ form_errors(form.researchMethod) }}
        <div class="mt-1 flex flex-col gap-2">
            {%- for choice in form.researchMethod %}
                <div class="w-full px-4 py-4 border rounded-lg border-stone-300 has-checked:bg-zpid-blue-50 flex items-start">
                    {{ form_row(choice) }}
                </div>
                {% if choice.vars.value == enum('App\\Enum\\Study\\ResearchMethod').EXPERIMENTAL.value %}
                        {% if choice.vars.checked %}
                            <div class="ml-6 mb-3">
                                {{ form_row(form.experimentalDetails) }}
                            </div>
                        {% else %}
                            {% do form.experimentalDetails.setRendered %}
                        {% endif %}
                {% elseif choice.vars.value == enum('App\\Enum\\Study\\ResearchMethod').SURVEY.value %}
                    {% if choice.vars.checked %}
                        <div class="ml-6 mb-3">
                            {{ form_row(form.surveyInstrumentType) }}
                        </div>
                    {% else %}
                        {% do form.surveyInstrumentType.setRendered %}
                    {% endif %}
                {% endif %}
            {% endfor -%}
        </div>
    </twig:Form:FormCard>

    {% if enum('App\\Enum\\Study\\ResearchMethod').EXPERIMENTAL.value in research_method %}
        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').SETTING }}">
            <twig:Form:MultilineChoiceForm form="{{ form.setting }}"/>

            {% if form.setting.vars.value == enum('App\\Enum\\Study\\StudySetting').FIELD.value %}
                {{ form_row(form.settingLocation) }}
            {% else %}
                {% do form.settingLocation.setRendered %}
            {% endif %}
        </twig:Form:FormCard>

        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RANDOMIZATION }}">
            <twig:Form:MultilineChoiceForm form="{{ form.randomization }}"/>
        </twig:Form:FormCard>

        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').EXPERIMENTAL_DESIGN }}">
            <twig:Form:MultilineChoiceForm form="{{ form.experimentalDesign }}"/>
        </twig:Form:FormCard>

        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').CONTROL_OPERATIONS }}">
            <twig:Form:MultilineChoiceForm form="{{ form.controlOperations }}"/>

            {% if form.controlOperations.vars.value == enum('App\\Enum\\Study\\ControlOperations').OTHER.value %}
                {{ form_row(form.otherControlOperations) }}
            {% else %}
                {% do form.otherControlOperations.setRendered %}
            {% endif %}
        </twig:Form:FormCard>

        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').TREATMENT_GROUPS }}">
            <twig:Form:CollectionForm
                collection="{{ form.treatmentGroups }}"
                add_action="addTreatmentGroup"
                remove_action="removeTreatmentGroup"
                add_label="{{ 'method_meta_data_group.treatment_groups.add'|trans([], 'forms') }}"
            />
        </twig:Form:FormCard>
    {% else %}
        {% do form.experimentalDesign.setRendered %}
        {% do form.controlOperations.setRendered %}
        {% do form.otherControlOperations.setRendered %}
        {% do form.treatmentGroups.setRendered %}
    {% endif %}

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').MEASUREMENT_OCCASIONS }}">
        {{ form_label(form.measurementOccasions) }}
        {{ form_errors(form.measurementOccasions) }}
        <div class="mt-1">
            <ul>
                {% for key, occasion in form.measurementOccasions %}
                    <li class='pb-4 mt-2 border rounded border-stone-400 first:mt-0 text-stone-800'>
                        <div class="flex justify-between items-center">
                            <h2 class="pl-2 font-semibold">
                                {{ 'input.measurement_occasions.name'|trans }} {{ key + 1 }}
                            </h2>
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="removeMeasurementOccasion"
                                    data-live-index-param="{{ key }}"
                                    class="Creator-RemoveButton">
                                {{ 'method_meta_data_group.measurement_occasions.remove'|trans([], 'forms') }}
                            </button>
                        </div>

                        <div class="px-4">
                            {{ form_row(occasion.timeOfMeasurement) }}
                            {% if enum('App\\Enum\\Study\\ResearchMethod').EXPERIMENTAL.value in research_method  %}
                                {{ form_row(occasion.intervention) }}
                            {% else %}
                                {% do occasion.intervention.setRendered %}
                            {% endif %}
                        </div>
                        <span class="hidden">{{ form_row(occasion.position) }}</span>
                    </li>
                {% endfor %}
            </ul>

            <button type="button"
                    class="mt-2 Button_secondary_act Button_fieldSize"
                    data-action="live#action"
                    data-live-action-param="addMeasurementOccasion">
                {{ include('components/icons/add.svg') }}
                {{ 'method_meta_data_group.measurement_occasions.add'|trans([], 'forms') }}
            </button>
        </div>
        {% do form.measurementOccasions.setRendered %}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').CONSTRUCTS }}">
        {{ form_label(form.constructs) }}
        {{ form_errors(form.constructs) }}
        <div class="mt-1">
            <ul>
                {% for key, construct in form.constructs %}
                    <li class='pb-4 mt-2 border rounded border-stone-400 first:mt-0'>
                        <div class="flex justify-between items-center">
                            <h2 class="pl-2 font-semibold">
                                {{ 'input.constructs.name'|trans }} {{ key + 1 }}
                            </h2>
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="removeConstruct"
                                    data-live-index-param="{{ key }}"
                                    class="Creator-RemoveButton">
                                {{ 'method_meta_data_group.constructs.remove'|trans([], 'forms') }}
                            </button>
                        </div>


                        <div class="w-full grid lg:grid-cols-4 gap-2 px-4">
                            <span class="col-span-3">
                                {{ form_row(construct.name) }}
                            </span>
                            {{ form_row(construct.constructFunction) }}
                            <span class="col-span-4">
                                {% if construct.constructFunction.vars.value == enum('App\\Enum\\Study\\ConstructFunction').OTHER.value %}
                                    {{ form_row(construct.otherFunctionDescription) }}
                                {% else %}
                                    {% do construct.otherFunctionDescription.setRendered %}
                                {% endif %}
                            </span>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <button type="button"
                    class="mt-2 Button_secondary_act Button_fieldSize"
                    data-action="live#action"
                    data-live-action-param="addConstruct">
                {{ include('components/icons/add.svg') }}
                {{ 'method_meta_data_group.constructs.add'|trans([], 'forms') }}
            </button>
        </div>
        {% do form.constructs.setRendered %}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').MEASUREMENT_INSTRUMENTS }}">
        {{ form_label(form.measurementInstruments) }}
        {{ form_errors(form.measurementInstruments) }}
        <div class="mt-1">
            <ul>
                {% for key, instrument in form.measurementInstruments %}
                    <li class='pb-4 mt-2 border rounded border-stone-400 first:mt-0'>
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="removeMeasurementInstrument"
                                data-live-index-param="{{ key }}"
                                class="Creator-RemoveButton">
                            {{ 'method_meta_data_group.measurement_instruments.remove'|trans([], 'forms') }}
                        </button>

                        <div class="w-full px-4">
                            {{ form_row(instrument.title) }}
                            {{ form_row(instrument.author) }}
                            {{ form_row(instrument.citation) }}
                            {{ form_row(instrument.newlyDeveloped) }}
                            {% if instrument.newlyDeveloped.vars.checked %}
                                {{ form_row(instrument.abstract) }}
                                {{ form_row(instrument.theoreticalBackground) }}
                                {{ form_row(instrument.structure) }}
                                {{ form_row(instrument.development) }}
                                {{ form_row(instrument.objectivity) }}
                                {{ form_row(instrument.reliability) }}
                                {{ form_row(instrument.validity) }}
                                {{ form_row(instrument.normReferenced) }}
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <button type="button"
                    class="mt-2 Button_secondary_act Button_fieldSize"
                    data-action="live#action"
                    data-live-action-param="addMeasurementInstrument">
                {{ include('components/icons/add.svg') }}
                {{ 'method_meta_data_group.measurement_instruments.add'|trans([], 'forms') }}
            </button>
        </div>
        {% do form.measurementInstruments.setRendered %}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RESEARCH_METHOD_DESCRIPTION }}">
        {{ form_row(form.researchMethodDescription) }}
    </twig:Form:FormCard>
{% endblock %}


