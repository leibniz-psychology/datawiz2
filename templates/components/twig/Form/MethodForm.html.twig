{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.theories.title"|trans }}
{% endblock %}

{% set research_method = form.researchMethod.vars.value %}

{% block form_content %}
    <twig:Form:FormCard entry="{{ enum('App\\Enum\\MethodDictionary').RESEARCH_METHOD }}">
        {{ form_label(form.researchMethod) }}
        {{ form_errors(form.researchMethod) }}
        <div class="mt-1 flex flex-col gap-2">
            {%- for choice in form.researchMethod %}
                <div class="w-full px-4 py-4 border rounded-lg border-stone-300 has-checked:bg-zpid-blue-50 flex items-start">
                    {{ form_widget(choice) }}
                    {{ form_label(choice, null, {
                        label_attr: {
                            class: 'm-0'
                        }
                    }) }}
                </div>
            {% endfor -%}
        </div>


        <div class="mt-3">
            {% if research_method == enum('App\\Enum\\ResearchMethod').EXPERIMENTAL.value %}
                <twig:Form:MultilineChoiceForm form="{{ form.experimentalDetails }}"/>

                {% do form.nonExperimentalDetails.setRendered %}
                {% do form.observationalType.setRendered %}
            {% elseif research_method == enum('App\\Enum\\ResearchMethod').NON_EXPERIMENTAL.value %}
                <div>
                    {{ form_label(form.nonExperimentalDetails) }}
                    {{ form_errors(form.nonExperimentalDetails) }}

                    <div class="flex flex-col gap-2 mt-1">
                        {%- for choice in form.nonExperimentalDetails %}
                            <div class="flex">
                                {{ form_widget(choice) }}
                                {{ form_label(choice, null, {
                                    'label_attr': {'class': '[&_span]:block [&_span]:last:text-sm [&_span]:last:text-stone-600'},
                                    'label_html': true,
                                }) }}
                            </div>
                            {% if choice.vars.value == enum('App\\Enum\\NonExperimentalDetails').OBSERVATIONAL_STUDY.value %}
                                <div class="ml-6">
                                    {{ form_row(form.observationalType, {
                                        'attr': {
                                            'disabled': not choice.vars.checked,
                                        }
                                    }) }}
                                </div>
                            {% endif %}
                        {% endfor -%}
                    </div>

                </div>
                {% do form.experimentalDetails.setRendered %}
            {% else %}
                {% do form.experimentalDetails.setRendered %}
                {% do form.nonExperimentalDetails.setRendered %}
                {% do form.observationalType.setRendered %}
            {% endif %}
        </div>
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\MethodDictionary').SETTING }}">
        <twig:Form:MultilineChoiceForm form="{{ form.setting }}"/>

        {{ form_row(form.settingLocation, {
            'attr': {
                'disabled': form.setting.vars.value == enum('App\\Enum\\StudySetting').ARTIFICIAL.value,
            }
        }) }}
    </twig:Form:FormCard>

    {% if research_method == enum('App\\Enum\\ResearchMethod').EXPERIMENTAL.value %}
        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\MethodDictionary').MANIPULATIONS }}">
            {{ form_row(form.manipulations) }}
        </twig:Form:FormCard>

        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\MethodDictionary').EXPERIMENTAL_DESIGN }}">
            <twig:Form:MultilineChoiceForm form="{{ form.experimentalDesign }}"/>
        </twig:Form:FormCard>

        <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\MethodDictionary').CONTROL_OPERATIONS }}">
            <twig:Form:MultilineChoiceForm form="{{ form.controlOperations }}"/>

            {{ form_row(form.otherControlOperations, {
                'attr': {
                    'disabled': form.controlOperations.vars.value != enum('App\\Enum\\ControlOperations').OTHER.value,
                }
            }) }}
        </twig:Form:FormCard>
    {% else %}
        {% do form.manipulations.setRendered %}
        {% do form.experimentalDesign.setRendered %}
        {% do form.controlOperations.setRendered %}
        {% do form.otherControlOperations.setRendered %}
    {% endif %}

{% endblock %}


