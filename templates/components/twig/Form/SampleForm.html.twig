{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.samples.title"|trans }}
{% endblock %}

{% block form_content %}
    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').PARTICIPANTS }}">
        {{ form_row(form.participants) }}
        {{ form_row(form.sex) }}
        {{ form_row(form.age) }}
        {{ form_row(form.specialGroups) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').POPULATION }}">
        <twig:Form:CollectionForm
            collection="{{ form.population }}"
            add_action="addPopulation"
            remove_action="removePopulation"
            add_label="{{ 'sample_meta_data_group.population.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').INCLUSION_CRITERIA }}">
        <twig:Form:CollectionForm
            collection="{{ form.inclusionCriteria }}"
            add_action="addInclusion"
            remove_action="removeInclusion"
            add_label="{{ 'sample_meta_data_group.inclusion_criteria.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').EXCLUSION_CRITERIA }}">
        <twig:Form:CollectionForm
            collection="{{ form.exclusionCriteria }}"
            add_action="addExclusion"
            remove_action="removeExclusion"
            add_label="{{ 'sample_meta_data_group.exclusion_criteria.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').SAMPLING_METHOD }}">
        <twig:Form:MultilineChoiceForm form="{{ form.samplingMethod }}"/>
        {% if form.samplingMethod.vars.value == enum('App\\Enum\\Study\\SamplingMethod').OTHER.value %}
            {{ form_row(form.samplingMethodOtherDescription) }}
        {% else %}
            {% do form.samplingMethodOtherDescription.setRendered %}
        {% endif %}
    </twig:Form:FormCard>

    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').RECRUITING }}">
        {{ form_row(form.recruiting) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').SAMPLE_SIZE }}">
        {{ form_row(form.sampleSize) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').POWER_ANALYSIS }}">
        {{ form_row(form.powerAnalysis) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').INTENDED_SAMPLE_SIZE }}">
        {{ form_row(form.intendedSampleSize) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').UNIT_OF_ANALYSIS }}">
        {{ form_row(form.unitOfAnalysis) }}
        {% if form.unitOfAnalysis.vars.value == enum('App\\Enum\\Study\\SampleAnalysisUnit').OTHER.value %}
            {{ form_row(form.unitOfAnalysisOtherDescription) }}
        {% else %}
            {% do form.unitOfAnalysisOtherDescription.setRendered %}
        {% endif %}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').MULTILEVEL_STRUCTURE }}">
        {{ form_row(form.multilevelStructure) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').COUNTRY }}">
        {{ form_row(form.country) }}
        {{ form_row(form.city) }}
        {{ form_row(form.region) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').MISSING_VALUES }}">
        {{ form_row(form.missingValues) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').RETURN_DROPOUT }}">
        {{ form_row(form.returnDropout) }}
    </twig:Form:FormCard>
{% endblock %}


