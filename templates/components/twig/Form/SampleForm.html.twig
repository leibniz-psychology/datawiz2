{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.samples.title"|trans }}
{% endblock %}

{% block form_content %}
    <twig:Form:FormCard title="{{ 'input.participants.legend'|trans }}" help="{{ "participants" }}">
        {{ form_row(form.participants) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.population.legend'|trans }}" help="{{ "population" }}">
        <twig:Form:CollectionForm
            collection="{{ form.population }}"
            add_action="addPopulation"
            remove_action="removePopulation"
            add_label="{{ 'input.population.add'|trans }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.inclusion.legend'|trans }}" help="{{ "inclusion_criteria" }}">
        <twig:Form:CollectionForm
            collection="{{ form.inclusion_criteria }}"
            add_action="addInclusion"
            remove_action="removeInclusion"
            add_label="{{ 'input.inclusion.add'|trans }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.exclusion.legend'|trans }}" help="{{ "exclusion_criteria" }}">
        <twig:Form:CollectionForm
            collection="{{ form.exclusion_criteria }}"
            add_action="addExclusion"
            remove_action="removeExclusion"
            add_label="{{ 'input.exclusion.add'|trans }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.sampling.legend'|trans }}" help="{{ "sampling_method" }}">
        <twig:Form:MultilineChoiceForm form="{{ form.sampling_method }}"/>

        {{ form_row(form.otherSamplingMethod, {
            'attr': {
                'disabled': form.sampling_method.vars.value != 'Other'
            }
        }) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.sample-size.legend'|trans }}" help="{{ "sample_size" }}">
        {{ form_row(form.sample_size) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.power-analysis.legend'|trans }}" help="{{ "power_analysis" }}">
        {{ form_row(form.power_analysis) }}
    </twig:Form:FormCard>
{% endblock %}


