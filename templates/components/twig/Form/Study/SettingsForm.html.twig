<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'onkeydown': 'if(event.key === "Enter") {event.preventDefault(); event.stopPropagation();}',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}

    <twig:Form:FormCard title="{{ 'input.documentation-name.legend'|trans }}">
        <div>
            {{ form_label(form.shortName, null, {
                'label_attr': {
                    'class': 'block max-w-prose'
                },
            }) }}
        </div>
        {{ form_errors(form.shortName) }}
        <div class="mt-1 md:items-center md:flex">
            {{ form_widget(form.shortName, {
                'attr': {
                    'class': 'w-full md:w-3/4',
                }
            }) }}
            <button class="Button_primary_act Button_standalone mt-1 md:mt-0 md:ml-2" {{ live_action('save') }}>
                {{ "generic.rename"|trans }}
            </button>
        </div>
    </twig:Form:FormCard>

    {{ form_rest(form) }}

    {{ form_end(form) }}
</div>
