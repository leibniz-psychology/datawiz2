<div class="col-span-7" {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'onkeydown': 'if(event.key === "Enter") {event.preventDefault(); event.stopPropagation();}',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    <div class="grid grid-cols-7 gap-4">
        <div class="col-span-2">
            <div class="sticky top-0 overflow-hidden border rounded-lg shadow-sm">
                <twig:Form:Study:NavigationSidebar needs_saving="true" experiment="{{ this.initialFormData.experiment }}" form_type="{{ this.formType }}"/>
            </div>
        </div>

        <div class="col-span-5">
            <section class="border rounded-lg shadow-sm bg-stone-50">
                <h2 class="MetaDataGroup-Title">
                    {% block title %}
                        {{ "title.theories.title"|trans }}
                    {% endblock %}
                </h2>
                <div class="flex flex-col gap-6">
                    {% block form_content %}
                    {% endblock %}

                    {{ form_rest(form) }}
                </div>

                <div class="WizNavBar">
                    <button type="submit" class="underline justify-self-start Button_tertiary_go Button_standalone" type="submit" {% if this.prevForm == null %} {{ live_action('save', { route: 'Study-datasets' }) }} {% else %} {{ live_action('save', { route: this.prevForm.route }) }} {% endif %}>
                        {{ include('components/icons/arrow-left.svg') }}
                        {% if this.prevForm == null %}
                            {{ 'title.introduction.title' | trans }}
                        {% else %}
                            {{ this.prevForm.title | trans }}
                        {% endif %}
                    </button>

                    {% if form is defined and form is not null %}
                        <button class="MetaData-SubmitButton Button_primary_act Button_standalone" type="submit" {{ live_action('save') }}>
                            {{ 'generic.save-changes' | trans }}
                        </button>
                    {% endif %}

                    <button type="submit" class="underline justify-self-end Button_tertiary_go Button_standalone" type="submit" {% if this.nextForm == null %} {{ live_action('save', { route: 'Study-datasets' }) }} {% else %} {{ live_action('save', { route: this.nextForm.route }) }} {% endif %}>
                        {% if this.nextForm == null %}
                            {{ 'title.dataset.title-short' | trans }}
                        {% else %}
                            {{ this.nextForm.title | trans }}
                        {% endif %}
                        {{ include('components/icons/arrow-right.svg') }}
                    </button>
                </div>
            </section>
        </div>
    </div>
    {{ form_end(form) }}
</div>
