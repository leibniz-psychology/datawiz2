{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.theories.title"|trans }}
{% endblock %}

{% block form_content %}
    <twig:Form:FormCard entry="{{ enum('App\\Enum\\TheoryDictionary').OBJECTIVES }}">
        <twig:Form:CollectionForm
            collection="{{ form.objectives }}"
            add_action="addObjective"
            remove_action="removeObjective"
            add_label="{{ 'input.objectives.add'|trans }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\TheoryDictionary').HYPOTHESES }}">
        <twig:Form:CollectionForm
            collection="{{ form.hypotheses }}"
            add_action="addHypothesis"
            remove_action="removeHypothesis"
            add_label="{{ 'input.hypotheses.add'|trans }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\TheoryDictionary').THEORIES }}">
        <twig:Form:CollectionForm
            collection="{{ form.theories }}"
            add_action="addTheory"
            remove_action="removeTheory"
            add_label="{{ 'input.theories.add'|trans }}"
        />
    </twig:Form:FormCard>
{% endblock %}


