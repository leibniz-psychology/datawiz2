{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.theories.title"|trans }}
{% endblock %}

{% block form_content %}
    <twig:Form:FormCard title="{{ 'input.objective.legend'|trans }}" help="{{ "objective" }}">
        {{ form_row(form.objective) }}
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" title="{{ 'input.hypothesis.legend'|trans }}" help="{{ "hypothesis" }}">
        {{ form_row(form.hypothesis) }}
    </twig:Form:FormCard>
{% endblock %}


