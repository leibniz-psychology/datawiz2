{% extends "components/twig/Form/_baseForm.html.twig" %}

{% block title %}
    {{ "title.theories.title"|trans }}
{% endblock %}

{% block form_content %}
    <twig:Form:FormCard entry="{{ enum('App\\Enum\\Study\\Dictionary\\TheoryDictionary').OBJECTIVES }}">
        <twig:Form:CollectionForm
            collection="{{ form.objectives }}"
            add_action="addObjective"
            remove_action="removeObjective"
            add_label="{{ 'theory_meta_data_group.objectives.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\TheoryDictionary').HYPOTHESES }}">
        <twig:Form:CollectionForm
            collection="{{ form.hypotheses }}"
            add_action="addHypothesis"
            remove_action="removeHypothesis"
            add_label="{{ 'theory_meta_data_group.hypotheses.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\TheoryDictionary').EXPLORATORY_RESEARCH_QUESTIONS }}">
        <twig:Form:CollectionForm
            collection="{{ form.exploratoryResearchQuestions }}"
            add_action="addExploratoryResearchQuestion"
            remove_action="removeExploratoryResearchQuestion"
            add_label="{{ 'theory_meta_data_group.exploratory_research_questions.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>

    <twig:Form:FormCard class="mt-8" entry="{{ enum('App\\Enum\\Study\\Dictionary\\TheoryDictionary').THEORIES }}">
        <twig:Form:CollectionForm
            collection="{{ form.theories }}"
            add_action="addTheory"
            remove_action="removeTheory"
            add_label="{{ 'theory_meta_data_group.theories.add'|trans([], 'forms') }}"
        />
    </twig:Form:FormCard>
{% endblock %}


