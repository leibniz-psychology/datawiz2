{% use 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_attr = row_attr|merge({ class: row_attr.class|default(row_class|default('pt-1')) }) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block widget_attributes -%}
    {%- set attr = attr|merge({ class: attr.class|default(widget_class|default('mt-1 w-full disabled:opacity-50')) ~ (errors|length ? ' ' ~ widget_errors_class|default('border-red-700!')) }) -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({ class: label_attr.class|default(label_class|default('block mt-1 leading-snug max-w-prose') ~ (disabled ? ' ' ~ '!text-stone-500') ) }) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{% block form_label_content %}
    {{- parent() -}}
    {%- if required is defined and required -%}
        <span class="required-star {% if disabled %} text-stone-300 {% else %} text-red-700 {% endif %}"> *</span>
    {%- endif -%}
{% endblock form_label_content %}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({ class: help_attr.class|default(help_class|default('mt-1 text-sm font-light text-stone-500 disabled:text-stone-300!')) }) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block radio_widget -%}
    {%- set widget_class = widget_class|default('mr-2 radio') -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if form is not rootform -%}<small class="error w-full inline-block">{%- else -%}<div class="error-message mb-3">{%- endif -%}
        {%- for error in errors -%}
            <span class="{{ error_item_class|default('text-red-700') }}">{{ error.message }}</span>
            {%- if not loop.last -%}, {%- endif -%}
        {%- endfor -%}
        {%- if form is not rootform -%}</small>{% else %}</div>{%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}

{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({ class: attr.class|default('mt-2 flex flex-col gap-2') }) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
        <div class="flex items-start">
            {% set child_disabled = child.vars.attr.disabled is defined and child.vars.attr.disabled == true %}
            {{- form_widget(child) -}}
            {{- form_label(child, null, { translation_domain: choice_translation_domain, label_attr: {'class': 'block [&_.required-star]:hidden' ~ (child_disabled ? ' ' ~ 'cursor-normal text-stone-500')} }) -}}
        </div>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}


