{% extends "base.html.twig" %}

{% block body %}
    <div class="max-w-(--breakpoint-xl) pl-2 mx-auto flex">
        <a href="{{ path("Project-overview") }}"
           class="mt-2 underline Button_tertiary_go Button_standalone justify-self-start">
            {{ include('components/icons/arrow-left.svg') }}
            {{ 'project.overview.title'|trans }}
        </a>
    </div>
    <div class="grid grid-cols-10 gap-4 max-w-(--breakpoint-xl) mx-auto mt-2 bg-white gap-x-4 gap-y-1 min-h-[calc(100%-15.75rem)] mb-12">
        {% block navigation_and_content %}
            <div class="col-span-2">
                <div class="sticky top-0 overflow-hidden border rounded-lg shadow-sm">
                    <twig:Form:Project:NavigationSidebar project="{{ project }}"/>
                </div>
            </div>

            <div class="col-span-5">
                <section class="border rounded-lg shadow-sm bg-stone-50">
                    {% block content %}
                    {% endblock %}
                </section>
            </div>
        {% endblock %}

        <div class="col-span-3">
            <aside class="sticky top-0 overflow-hidden border rounded-lg shadow-sm bg-white scrollbar scrollbar-thumb-gray-400 scrollbar-thin scrollbar-track-gray-100 max-h-[calc(100vh)] overflow-y-auto">
                {% block help_for_section %}
                    <div class="w-full Help-Text Help-Text_section markdown">
                        <h1>
                            Help for this section
                        </h1>
                        <p>
                            Help! Anybody?
                        </p>
                    </div>
                {% endblock %}
                <div>
                    {% block help_for_metadata %}
                    {% endblock %}
                </div>
            </aside>
        </div>
    </div>
{% endblock %}
