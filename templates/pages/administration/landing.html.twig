{% extends "layouts/corporate.html.twig" %}

{% block javascripts %}
    {{ encore_entry_script_tags("landing") }}
{% endblock %}

{% block body %}
    <main class="mx-24 mt-12">
        <h1 class="text-xl">
            <b>ATTENTION:</b> This is a demo version of DataWiz2.
            It is not intended for productive use but only for demonstration purposes.
            If you plan to use DataWiz for your research, please use the original
            <a href="https://datawiz.leibniz-psychology.org/DataWiz/" class="text-zpid-blue-800 hover:underline no-linkout">DataWiz</a>
            until DataWiz2 is released.
            Otherwise, your <b>data might be lost</b> during future updates.
        </h1>
        <br>

        <h1 class="text-3xl font-semibold text-zpid-purple-700 max-w-prose">
            DataWiz &mdash; the data management tool for researching psychologists
        </h1>

        <p class="mt-4 text-lg max-w-prose">
            Here's how DataWiz helps you during the whole research process:
        </p>

        <div class="flex flex-col">
            <h2 class="px-2 py-1 mt-8 text-2xl font-semibold leading-relaxed bg-gray-100 text-zpid-purple">
                Data documentation
            </h2>
            <div class="flex mt-4 gap-4">
                <img src="{{ asset('images/rdm_teaser.jpg') }}"
                     alt="DataWiz codebook editor"
                     class="order-2 w-1/2 mb-4 rounded shadow-xl"
                     width="575" height="259"/>
                <div class="order-1 w-1/2">
                    <p class="leading-snug">
                        Years of experience with the research data center
                        at ZPID have shown that data management is most
                        effective when it is instated early, preferably
                        concomitant with the research process.
                    </p>
                    <ul class="mt-4 leading-snug list-disc list-inside">
                        <li class="mt-2 ml-2">Document your studies</li>
                        <li class="mt-2 ml-2">Add and edit codebooks</li>
                        <li class="mt-2 ml-2">Upload materials</li>
                        <li class="mt-2 ml-2">Export in open data formats</li>
                    </ul>
                </div>
            </div>
            <button class="mx-auto mt-12 mb-8 text-xl Button_primary_go Button_standalone px-8! py-2!"
                    onclick="location.href='{{ path("Security-login") }}';">
                Start using DataWiz - it's free!
            </button>
        </div>

        <div class="relative mt-12 mb-6">
            <h2 class="px-2 py-1 text-2xl font-semibold leading-relaxed bg-gray-100 text-zpid-purple">
                Data Management Plans
            </h2>
            <div class="flex mt-4 gap-4">
                {# <img src="https://via.placeholder.com/550x300.png/DDCCCC/999999/?text=Ethics+Product+Teaser" alt="Ethics-Dummy-Teaser" class="order-2 mb-4 ml-4"> #}
                <img src="{{ asset('images/data_management_plan_teaser.png') }}"
                     alt="DataWiz codebook editor"
                     class="order-2 w-1/2 mb-4 ml-4 rounded shadow-xl"
                     width="575" height="259"/>
                <div class="order-2 w-1/2">
                    <p class="leading-snug">
                        Data management plans are a key part of good research data management.
                        They are often required by research funders and provide a structured way to plan
                        how research data will be handled during and after a research project.
                    </p>
                    <ul class="mt-4 leading-snug list-disc list-inside">
                        <li class="mt-2 ml-2">
                            Generate a data management plan according to the requirements of research funders.
                        </li>
                        <li class="mt-2 ml-2">
                            Plan the research data management of your project according to best practices.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
