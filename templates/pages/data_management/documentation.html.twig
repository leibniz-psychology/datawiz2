{% extends "layouts/dataManagement.html.twig" %}
{% from "components/_macros.html.twig" import sectionHelp %}
{% from "components/_macros.html.twig" import formHelp %}

{% set isPartOfDmp = true %}

{% block title %}
    {{ 'data_management_plan.documentation.title'|trans }}
{% endblock %}

{% block navigation_and_content %}
    <twig:Form:DataManagementPlan:DmpDocumentationForm initialFormData="{{ dataManagementPlan.documentation }}"/>
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp('data_management_plan.documentation') }}
{% endblock %}

{% block help_for_metadata %}
    {% for entry in enum('App\\Enum\\DataManagementPlan\\Dictionary\\DmpDocumentationDictionary').cases %}
        {% if entry.descriptionHelp != null %}
            <twig:Form:FormHelp dictionary="{{ entry }}"/>
        {% endif %}
    {% endfor %}
{% endblock %}
