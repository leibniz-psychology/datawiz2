{% extends "layouts/dataManagement.html.twig" %}
{% from "components/_macros.html.twig" import sectionHelp %}
{% from "components/_macros.html.twig" import formHelp %}

{% set isPartOfDmp = true %}

{% macro sectionTitle(titleText) %}
    <h2 class="text-xl font-bold border-b text-zpid-purple border-zpid-purple">{{ titleText }}</h2>
{% endmacro %}

{% block title %}
    {{ 'data_management_plan.review.title'|trans }}
{% endblock %}

{% block content %}
    <h2 class="MetaDataGroup-Title">
        {{ 'data_management_plan.review.title'|trans }}
    </h2>
    <p class="mx-6 mt-3 max-w-prose">
        {{ 'data_management_plan.review.description'|trans }}
    </p>
    <article class="px-6">
        <section class="mt-8">
            {{ _self.sectionTitle('data_management_plan.administrative_data.title'|trans) }}
            {% for entry in enum('App\\Enum\\DataManagementPlan\\Dictionary\\DmpAdministrativeDataDictionary').cases %}
                <twig:ReviewValue entity="{{ dataManagementPlan.administrativeData }}" route="{{ path('Dmp-edit-administrative', {id: dataManagementPlan.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>

        <section class="mt-8">
            {{ _self.sectionTitle('data_management_plan.research_data.title'|trans) }}
            {% for entry in enum('App\\Enum\\DataManagementPlan\\Dictionary\\DmpResearchDataDictionary').cases %}
                <twig:ReviewValue entity="{{ dataManagementPlan.researchData }}" route="{{ path('Dmp-edit-research-data', {id: dataManagementPlan.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>

        <section class="mt-8">
            {{ _self.sectionTitle('data_management_plan.documentation.title'|trans) }}
            {% for entry in enum('App\\Enum\\DataManagementPlan\\Dictionary\\DmpDocumentationDictionary').cases %}
                <twig:ReviewValue entity="{{ dataManagementPlan.documentation }}" route="{{ path('Dmp-edit-documentation', {id: dataManagementPlan.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>

        <section class="mt-8">
            {{ _self.sectionTitle('data_management_plan.data_sharing.title'|trans) }}
            {% for entry in enum('App\\Enum\\DataManagementPlan\\Dictionary\\DmpDataSharingDictionary').cases %}
                <twig:ReviewValue entity="{{ dataManagementPlan.dataSharing }}" route="{{ path('Dmp-edit-data-sharing', {id: dataManagementPlan.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>

        <section class="mt-8">
            {{ _self.sectionTitle('data_management_plan.storage_infrastructure.title'|trans) }}
            {% for entry in enum('App\\Enum\\DataManagementPlan\\Dictionary\\DmpStorageInfrastructureDictionary').cases %}
                <twig:ReviewValue entity="{{ dataManagementPlan.storageInfrastructure }}" route="{{ path('Dmp-edit-storage-infrastructure', {id: dataManagementPlan.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>
    </article>

    <twig:NavigationSavebar
        prevUrl="{{ path('Dmp-edit-storage-infrastructure', {id: dataManagementPlan.id}) }}"
        prevTitle="{{ 'data_management_plan.storage_infrastructure.title'|trans }}"
    />
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp('data_management_plan.review') }}
{% endblock %}
