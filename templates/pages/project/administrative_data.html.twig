{% extends "layouts/project.html.twig" %}
{% from "components/_macros.html.twig" import sectionHelp %}

{% set isPartOfProject = true %}

{% block title %}
    {{ 'project.administrative_data.title'|trans }}
{% endblock %}

{% block navigation_and_content %}
    <twig:Form:Project:ProjectAdministrativeDataForm initialFormData="{{ project.administrativeData }}"/>
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp('project.administrative_data') }}
{% endblock %}

{% block help_for_metadata %}
    {% for entry in enum('App\\Enum\\Project\\Dictionary\\ProjectAdministrativeDataDictionary').cases %}
        {% if entry.descriptionHelp != null %}
            <twig:Form:FormHelp dictionary="{{ entry }}"/>
        {% endif %}
    {% endfor %}
{% endblock %}
