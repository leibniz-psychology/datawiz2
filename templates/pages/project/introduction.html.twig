{% extends "layouts/project.html.twig" %}
{% from "components/_macros.html.twig" import sectionHelp %}

{% set isPartOfProject = true %}

{% macro startButton(startUrl) %}
    <a href="{{ startUrl }}"
       class="table mx-auto mt-6 mb-10 no-underline! Button_primary_go Button_standalone">
        {{ 'project.introduction.get_started'|trans }}
    </a>
{% endmacro %}

{% block title %}
    {{ 'project.introduction.title'|trans }}
{% endblock %}

{% block content %}
    <h2 class="MetaDataGroup-Title">
        {{ 'project.introduction.title'|trans }}
    </h2>

    <div class="px-6 markdown">
        {{ "project.introduction.intro"
        | trans({
            '#startBtn#':_self.startButton(path('Project-edit-administrative', {id: project.id}))})
        | markdown_to_html }}
    </div>

    <twig:NavigationSavebar
        nextUrl="{{ path('Project-edit-administrative', {id: project.id}) }}"
        nextTitle="{{ 'project.administrative_data.title'|trans }}"
    />
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp("project.introduction") }}
{% endblock %}
