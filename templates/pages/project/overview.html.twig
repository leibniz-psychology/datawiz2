{% extends "base.html.twig" %}
{% from "components/_macros.html.twig" import sectionHelp %}

{% set isPartOfProject = true %}

{% block title %}
    {{ 'project.overview.title'|trans }}
{% endblock %}

{% block body %}
    <div class="mx-auto mt-12 min-h-[calc(100%-15.5rem)] flex gap-x-12 max-w-(--breakpoint-xl) mb-12">
        <main {% if projects %}class="w-[70%]" {% else %}class="w-1/2"{% endif %}>
            <h2 class="ml-8 text-3xl font-bold text-zpid-purple-700">
                {{ 'project.overview.title'|trans }}
            </h2>
            <p class="mt-4 ml-8 max-w-prose">{{ 'project.overview.intro'|trans }}</p>
            <button class="mt-3 ml-8 Button_primary_act Button_standalone"
                    onclick="window.location.href='{{ path("Project-new") }}'">
                {{ 'project.overview.new'|trans }}
            </button>
            {% if projects %}
                <div class="mt-4">
                    <div class="mt-10 ml-8">
                        <h3 class="flex-shrink-0 text-2xl font-bold text-zpid-purple-700">
                            {{ 'project.overview.list.header'|trans }}
                        </h3>
                    </div>
                    <ul class="mt-4 list">
                        {% for project in projects %}
                            <li class="p-4 mt-2 ml-8 first:mt-0 bg-stone-50">
                                <div class="grid grid-cols-6">
                                    <h4 class="text-2xl font-semibold text-zpid-purple-700 col-span-full">
                                        <a class="underline"
                                           href="{{ path('Project-introduction', {id: project.id}) }}">
                                            {{ project.administrativeData.projectTitle ?? ('project.untitled'|trans) }}
                                        </a>
                                    </h4>
                                    {% if project.administrativeData.projectId %}
                                        <div class="mt-2 col-span-full">
                                            <span class="font-semibold">{{ 'project.administrative_data.project_id.legend'|trans({}, 'forms') }}:</span>
                                            <span>{{ project.administrativeData.projectId }}</span>
                                        </div>
                                    {% endif %}
                                    {% if project.administrativeData.funding %}
                                        <div class="col-span-full">
                                            <span class="font-semibold">{{ 'project.administrative_data.funding.legend'|trans({}, 'forms') }}:</span>
                                            <span>{{ project.administrativeData.funding }}</span>
                                        </div>
                                    {% endif %}
                                    {% if project.administrativeData.grantNumber %}
                                        <div class="col-span-full">
                                            <span class="font-semibold">{{ 'project.administrative_data.grant_number.legend'|trans({}, 'forms') }}:</span>
                                            <span>{{ project.administrativeData.grantNumber }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <h3 class="flex-shrink-0 mt-10 ml-8 text-2xl font-bold xl:flex text-zpid-purple-700">
                    {{ 'project.overview.list.header'|trans }}
                </h3>
                <p class="mx-8 mt-3 max-w-prose">{{ 'project.overview.list.empty'|trans }}</p>
            {% endif %}
        </main>
        <div class="w-[30%] mr-8">
            <aside class="sticky top-0 overflow-hidden border rounded-lg shadow-sm scrollbar scrollbar-thumb-gray-400 scrollbar-thin scrollbar-track-gray-100 max-h-[calc(100vh)] overflow-y-auto">
                {% block help_for_section %}
                    {{ sectionHelp('project') }}
                {% endblock %}
            </aside>
        </div>
    </div>
{% endblock %}
