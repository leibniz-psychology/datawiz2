{% extends "layouts/threeColumn.html.twig" %}
{% from "components/_macros.html.twig" import helpButton %}
{% from "components/_macros.html.twig" import sectionHelp %}
{% from "components/_macros.html.twig" import formHelp %}

{% macro sectionTitle(titleText) %}
    <h2 class="text-xl font-bold border-b text-zpid-purple border-zpid-purple">{{ titleText }}</h2>
{% endmacro %}

{% set isPartOfStudyDocumentation = true %}
{% set isStudyDescriptionSubItem = false %}

{% block title %}
    {{ "title.review.title"|trans }}
{% endblock %}

{% block content %}
    <h2 class="MetaDataGroup-Title">
        {{ "title.review.title"|trans }}
    </h2>
    <p class="mx-6 mt-3 max-w-prose">
        {{ "title.review.description"|trans }}
    </p>
    <article class="px-6">
        <section class="mt-8">
            {{ _self.sectionTitle("title.basic.title"|trans) }}
            {% for entry in enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').cases %}
                {% if entry != enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').CREATORS %}
                    <twig:ReviewValue entity="{{ experiment.basicInformationMetaDataGroup }}" route="{{ path('Study-documentation', {id: experiment.id}) }}" entry="{{ entry }}" />
                {% endif %}
            {% endfor %}
            {% if experiment.basicInformationMetaDataGroup.creators | length == 0 %}
                <twig:ReviewValue entity="{{ experiment.basicInformationMetaDataGroup }}" route="{{ path('Study-documentation', {id: experiment.id}) }}" entry="{{ enum('App\\Enum\\Study\\Dictionary\\BasicInformationDictionary').CREATORS }}" />
            {% else %}
                <div class="mt-5">
                    <h2 class="text-xl font-bold text-zpid-purple-700">{{ "basic_information_meta_data_group.creators.legend"|trans([], 'forms') }}</h2>
                    {% for creator in experiment.basicInformationMetaDataGroup.creators %}
                        <div class="px-6 pb-4 mb-4 border border-stone-300 rounded-lg">
                            {% for entry in enum('App\\Enum\\Study\\Dictionary\\CreatorDictionary').cases %}
                                <twig:ReviewValue entity="{{ creator }}" route="{{ path('Study-documentation', {id: experiment.id}) }}" entry="{{ entry }}" />
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
        <section class="mt-8">
            {{ _self.sectionTitle("title.theories.title"|trans) }}
            {% for entry in enum('App\\Enum\\Study\\Dictionary\\TheoryDictionary').cases %}
                <twig:ReviewValue entity="{{ experiment.theoryMetaDataGroup }}" route="{{ path('Study-theory', {id: experiment.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>
        <section class="mt-8">
            {{ _self.sectionTitle("title.method.title"|trans) }}
            {% for entry in enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').cases %}
                <twig:ReviewValue entity="{{ experiment.methodMetaDataGroup }}" route="{{ path('Study-method', {id: experiment.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>
        <section class="mt-8">
            {{ _self.sectionTitle("title.measures.title"|trans) }}
            {% for entry in enum('App\\Enum\\Study\\Dictionary\\MeasureDictionary').cases %}
                <twig:ReviewValue entity="{{ experiment.measureMetaDataGroup }}" route="{{ path('Study-measure', {id: experiment.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>
        <section class="mt-8">
            {{ _self.sectionTitle("title.samples.title"|trans) }}
            {% for entry in enum('App\\Enum\\Study\\Dictionary\\SampleDictionary').cases %}
                <twig:ReviewValue entity="{{ experiment.sampleMetaDataGroup }}" route="{{ path('Study-sample', {id: experiment.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>
        <section class="mt-8">
            {{ _self.sectionTitle("title.ethics.title"|trans) }}
            {% for entry in enum('App\\Enum\\Study\\Dictionary\\EthicsDictionary').cases %}
                <twig:ReviewValue entity="{{ experiment.ethicsMetaDataGroup }}" route="{{ path('Study-ethics', {id: experiment.id}) }}" entry="{{ entry }}" />
            {% endfor %}
        </section>
        {# TODO Add list of datasets #}
        {# <section class="mt-8">
            {{ _self.sectionTitle("title.dataset.title"|trans) }}
            <div class="mx-6 mt-2 italic">
                List of datasets goes here
            </div>
        </section> #}
        {# TODO Add list of materials #}
        {# <section class="mt-8">
            {{ _self.sectionTitle("title.material.title"|trans) }}
            <div class="mx-6 mt-2 italic">
                List of materials goes here
            </div>
        </section> #}
    </article>

    <twig:NavigationSavebar
        prevUrl="{{ path('Study-materials', {id: experiment.id}) }}"
        prevTitle="{{ 'title.material.title-short'|trans }}"
        nextUrl="{{ path('export_index', {id: experiment.id}) }}"
        nextTitle="{{ 'title.export.title-short'|trans }}"
    />
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp("review") }}
{% endblock %}
