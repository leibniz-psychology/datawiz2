{% extends "layouts/threeColumn.html.twig" %}
{% from "components/_macros.html.twig" import helpButton %}
{% from "components/_macros.html.twig" import sectionHelp %}
{% from "components/_macros.html.twig" import formHelp %}

{% set isPartOfStudyDocumentation = true %}
{% set isStudyDescriptionSubItem = true %}

{% block title %}
    {{ "title.basic.title"|trans }}
{% endblock %}

{% block navigation_and_content %}
    <twig:Form:BasicInformationForm initialFormData="{{ experiment.basicInformationMetaDataGroup }}"/>
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp("basic") }}
{% endblock %}

{% block help_for_metadata %}
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').TITLE }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').TITLE_TRANSLATED }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').DESCRIPTION }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').DESCRIPTION_TRANSLATED }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').DATA_STATUS }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').USED_SOFTWARES }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').RELATED_PUBLICATIONS }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').CONFLICTS_OF_INTEREST }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\BasicInformationDictionary').CREATORS }}"/>
{% endblock %}
