{% extends "layouts/threeColumn.html.twig" %}
{% from "components/_macros.html.twig" import helpButton %}
{% from "components/_macros.html.twig" import sectionHelp %}
{% from "components/_macros.html.twig" import formHelp %}

{% set isPartOfStudyDocumentation = true %}
{% set isStudyDescriptionSubItem = true %}

{% block title %}
    {{ "title.method.title"|trans }}
{% endblock %}

{% block navigation_and_content %}
    <twig:Form:MethodForm initialFormData="{{ experiment.methodMetaDataGroup }}"/>
{% endblock %}

{% block help_for_section %}
    {{ sectionHelp("method") }}
{% endblock %}

{% block help_for_metadata %}
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RESEARCH_DESIGN }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RESEARCH_METHOD }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').SETTING }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').MANIPULATIONS }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').EXPERIMENTAL_DESIGN }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').CONTROL_OPERATIONS }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').RESEARCH_METHOD_DESCRIPTION }}"/>
    <twig:Form:FormHelp dictionary="{{ enum('App\\Enum\\Study\\Dictionary\\MethodDictionary').CONSTRUCTS }}"/>
{% endblock %}
